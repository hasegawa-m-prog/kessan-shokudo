<% content_for :title, "回答履歴｜決算食堂" %>
<section class="learning">
  <h1>回答履歴</h1>
  <p>ログイン後の回答を学習回ごとにまとめ、開始日時の新しい順に表示しています。復習は1問ずつ別の記録として残ります。</p>
  <p><%= link_to "間違えた問題を復習する", reviews_path %></p>
  <% if @runs.empty? %>
    <p class="notice">このページに回答履歴はありません。クイズに回答するとここに残ります。</p>
  <% else %>
    <ol class="history-list">
      <% @runs.each do |run| %>
        <li class="card">
          <p class="note"><%= run.started_at.in_time_zone("Tokyo").strftime("%Y年%m月%d日 %H:%M") %>（日本時間）</p>
          <h2><%= link_to "#{run.industry&.name || 'おまかせ'} · #{run.kind == 'review' ? '1問復習' : '5問クイズ'}", quiz_run_path(run) %></h2>
          <p><%= run.quiz_run_questions.size %>問中 <%= run.correct_count %>問正解 · <%= run.answered_entries.size %>問回答済み</p>
          <p class="note"><%= run.completed_at ? "完了" : "未完了（回答済みの内容を表示できます）" %></p>
        </li>
      <% end %>
    </ol>
  <% end %>
  <nav aria-label="履歴のページ"><% if @page > 1 %><%= link_to "前の20件", histories_path(page: @page - 1) %><% end %><% if @has_next %><%= link_to "次の20件", histories_path(page: @page + 1) %><% end %></nav>
  <div class="actions"><%= link_to "クイズを始める", new_quiz_path, class: "button primary" %></div>
</section>
