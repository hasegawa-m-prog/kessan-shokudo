<% content_for :title, "#{@position}問目｜決算食堂" %>
<section class="learning">
  <p class="eyebrow"><%= @attempt.industry_name %> · <%= @position %> / 5問</p>
  <h1><%= @question.title %></h1>
  <p class="question-body"><%= @question.body %></p>
  <aside class="assumptions"><h2>この問題の条件</h2><p><%= @question.assumptions %></p></aside>
  <% if @selected_choice %>
    <%= render "feedback" %>
  <% end %>
  <%= render "diagrams" %>
  <% if @selected_choice %>
    <div class="actions">
      <% if @position == 5 %>
        <%= link_to "5問の結果を見る", result_quiz_path, class: "button primary" %>
      <% else %>
        <%= link_to "次の問題へ", quiz_path(position: @position + 1), class: "button primary" %>
      <% end %>
    </div>
  <% else %>
    <%= form_with url: answer_quiz_path do |form| %>
      <%= form.hidden_field :position, value: @position %>
      <%= form.hidden_field :attempt_token, value: @attempt.token %>
      <fieldset class="choice-list">
        <legend>答えを1つ選んでください</legend>
        <% @question.choices.each do |choice| %>
          <label><%= form.radio_button :choice_id, choice.id, required: true %> <%= choice.body %></label>
        <% end %>
      </fieldset>
      <%= form.submit "回答する", class: "button primary" %>
    <% end %>
  <% end %>
  <p class="note">架空の学習用データです。業種全体・実在企業の評価ではありません。</p>
</section>
