<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Kessan Shokudo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="決算食堂">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <%= link_to "決算食堂（仮）", root_path, class: "brand" %>
      <nav aria-label="メインメニュー">
        <% if current_user %>
          <%= link_to "回答履歴", histories_path %>
          <%= link_to "復習", reviews_path %>
          <span class="login-state">ログイン中</span>
          <%= button_to "ログアウト", session_path, method: :delete, class: "nav-button" %>
        <% else %>
          <%= link_to "ログイン", login_path %>
          <%= link_to "ユーザー登録", signup_path %>
        <% end %>
      </nav>
    </header>
    <main id="main" class="container">
      <% flash.each do |type, message| %>
        <div class="flash <%= type %>" role="<%= type == 'alert' ? 'alert' : 'status' %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="site-footer">決算食堂（仮） — 会計初心者のためのBS学習サービス · 開発中</footer>
  </body>
</html>
